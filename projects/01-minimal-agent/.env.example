# 复制为 .env 并填入真实值
# MockModel 不需要任何 key；接真实 LLM 时再填

# OpenAI（也兼容 DeepSeek / 通义千问的 OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Anthropic（可选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Agent 行为配置
AGENT_MAX_STEPS=5
AGENT_TRACE_DIR=./trace